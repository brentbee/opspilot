# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# Postgres connection string. For Supabase use the *Transaction pooler* string
# (Project → Connect → Transaction pooler, port 6543).
DATABASE_URL=postgres://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Your own Anthropic API key (set a monthly spend limit in the Anthropic Console).
ANTHROPIC_API_KEY=

# Optional
# AGENT_MODEL=claude-sonnet-5-5      # model for the agent loop
# WRITER_MODEL=claude-haiku-5-5      # model that streams the reply (defaults to AGENT_MODEL)
# RUN_LIMIT_PER_HOUR=40              # global cap on agent runs, protects the API key on a public demo
# CRON_SECRET=                       # random string; Vercel Cron sends it as a Bearer token
